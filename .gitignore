# --- Runtime logs (generated by start-server.sh / dev servers) ---
server.log
console.log
*.log
nohup.out

# --- Build output (generated by tools/bundle-single-file.mjs) ---
/dist/

# --- Dependencies (tools run on node; keep the game itself dependency-free) ---
node_modules/

# --- Package manager logs / caches ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# --- Environment / secrets ---
.env
.env.*

# --- Python (local static server) ---
__pycache__/
*.py[cod]

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- Temp / backups ---
*.tmp
*.bak
*.orig
